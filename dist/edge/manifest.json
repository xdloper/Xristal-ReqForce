{
  "manifest_version": 3,
  "name": "HTTP Interceptor & Telepresence",
  "version": "1.0.0",
  "description": "Request/Response Header, Body, CORS & Telepresence manipulation tool.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "HTTP Interceptor"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}